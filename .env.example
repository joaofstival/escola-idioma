# Servidor: use uma pasta privada e persistente, fora do OneDrive.
ESCOLA_SERVER_DATA=./var/escola
ESCOLA_HOST=127.0.0.1
ESCOLA_PORT=3489
# Defina como 1 somente ao usar proxy HTTPS e firewall.
ESCOLA_HTTPS_PROXY=0
# Desktop: opcional; também pode ser configurado na tela de login.
ESCOLA_API_URL=http://127.0.0.1:3489
# Senhas iniciais são definidas apenas na sessão de provisionamento.
