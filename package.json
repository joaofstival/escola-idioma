{
  "name": "escola-idioma",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema desktop de gestão de escola de idiomas (Electron + TypeScript)",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "seed": "npm run build && electron . --seed"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "7.0.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router-dom": "7.18.5",
    "sonner": "2.0.8",
    "sql.js": "1.16.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "esbuild": "0.28.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
